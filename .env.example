# Database: SQLite async for local dev (swap to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./exambuddy.db

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_DIR=./storage

# Crawler
CRAWLER_MAX_DEPTH=3
CRAWLER_REQUEST_DELAY=1.0
CRAWLER_RECENCY_SKIP_HOURS=24

# --- Phase 3: Anthropic Claude LLM ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_EXTRACT_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_INPUT_TOKENS=25000

# --- Phase 4: Email Notifications (Resend API) ---
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ExamBuddy <notices@exambuddy.app>
EMAIL_BACKEND=mock

# --- Phase 5+ (not needed yet) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
