# Database: SQLite async for local dev (swap to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./exambuddy.db

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_DIR=./storage

# Crawler
CRAWLER_MAX_DEPTH=3
CRAWLER_REQUEST_DELAY=1.0
CRAWLER_RECENCY_SKIP_HOURS=24

# --- Phase 3+ (not needed yet) ---
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
